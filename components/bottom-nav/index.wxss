.nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.nav-card {
  display: flex;
  border-radius: 32rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.theme-dark .nav-card {
  background: rgba(7, 10, 15, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.32);
}

.theme-light .nav-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(17, 31, 49, 0.08);
  box-shadow: 0 18rpx 44rpx rgba(17, 31, 49, 0.12);
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 24rpx;
}

.nav-item-active {
  background: rgba(29, 207, 118, 0.18);
}

.nav-text {
  font-size: 26rpx;
  font-weight: 600;
}
