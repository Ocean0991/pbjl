<view class="bottom-sheet-mask {{visible ? 'mask-visible' : ''}} {{themeClass}}" bindtap="handleMaskTap" catchtouchmove="true">
  <view class="bottom-sheet-container {{visible ? 'sheet-visible' : ''}}" catchtap="handleContentTap">
    <view class="sheet-handle">
      <view class="handle-bar"></view>
    </view>
    
    <view class="sheet-header" wx:if="{{title}}">
      <text class="sheet-title">{{title}}</text>
      <view class="sheet-close" bindtap="handleClose">
        <text class="close-icon">×</text>
      </view>
    </view>
    
    <scroll-view class="sheet-content" scroll-y="true">
      <slot></slot>
    </scroll-view>
  </view>
</view>
