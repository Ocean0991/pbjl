.bottom-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.theme-dark .bottom-sheet-mask {
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.theme-light .bottom-sheet-mask {
  background: rgba(17, 31, 49, 0.4);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.mask-visible {
  opacity: 1;
  visibility: visible;
}

.bottom-sheet-container {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  border-radius: 40rpx 40rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.theme-dark .bottom-sheet-container {
  background: rgba(27, 30, 36, 0.95);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: none;
}

.theme-light .bottom-sheet-container {
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border: 1rpx solid rgba(17, 31, 49, 0.08);
  border-bottom: none;
}

.sheet-visible {
  transform: translateY(0);
}

.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 12rpx;
}

.handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
}

.theme-dark .handle-bar {
  background: rgba(255, 255, 255, 0.2);
}

.theme-light .handle-bar {
  background: rgba(17, 31, 49, 0.15);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 40rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.theme-light .sheet-header {
  border-bottom-color: rgba(17, 31, 49, 0.06);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.theme-dark .sheet-title {
  color: #ffffff;
}

.theme-light .sheet-title {
  color: #0a0d12;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.theme-dark .sheet-close {
  background: rgba(255, 255, 255, 0.08);
}

.theme-light .sheet-close {
  background: rgba(17, 31, 49, 0.06);
}

.close-icon {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.theme-dark .close-icon {
  color: rgba(255, 255, 255, 0.6);
}

.theme-light .close-icon {
  color: rgba(19, 32, 46, 0.65);
}

.sheet-content {
  max-height: calc(70vh - 160rpx);
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-content::-webkit-scrollbar {
  display: none;
}
