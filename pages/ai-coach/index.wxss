.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F2F2F7;
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border-bottom: 0.5px solid #E5E5EA;
}

.header-back {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 28px;
  font-weight: 300;
  color: #1C1C1E;
}

.back-icon {
  width: 24px;
  height: 24px;
}

.header-info {
  flex: 1;
  text-align: center;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
}

.header-subtitle {
  font-size: 12px;
  color: #636366;
  display: block;
}

.header-spacer {
  width: 40px;
}

.chat-body {
  flex: 1;
  padding: 16px;
  overflow-y: auto;
}

.message {
  display: flex;
  margin-bottom: 16px;
  align-items: flex-start;
}

.message-user {
  justify-content: flex-end;
}

.message-coach {
  justify-content: flex-start;
}

.coach-avatar {
  width: 36px;
  height: 36px;
  border-radius: 18px;
  background-color: rgba(0, 122, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 18px;
}

.message-bubble {
  max-width: 75%;
  padding: 12px 16px;
  border-radius: 16px;
}

.bubble-coach {
  background-color: #FFFFFF;
  border-top-left-radius: 4px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.bubble-user {
  background-color: #007AFF;
  border-top-right-radius: 4px;
}

.message-text {
  font-size: 15px;
  line-height: 22px;
  color: #1C1C1E;
  white-space: pre-wrap;
}

.bubble-user .message-text {
  color: #FFFFFF;
}

.typing-bubble {
  padding: 16px 20px;
}

.typing-dots {
  display: flex;
  gap: 4px;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: #C7C7CC;
  animation: typing 1.4s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}

.suggestions {
  padding: 0 16px 8px;
}

.suggestions-title {
  font-size: 14px;
  color: #636366;
  display: block;
  margin-bottom: 8px;
}

.suggestions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.suggestion-chip {
  padding: 8px 16px;
  background-color: #FFFFFF;
  border-radius: 20px;
  border: 1px solid #E5E5EA;
}

.suggestion-text {
  font-size: 14px;
  color: #007AFF;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 8px 16px;
  padding-bottom: 32px;
  background-color: #FFFFFF;
  border-top: 0.5px solid #E5E5EA;
  gap: 8px;
}

.chat-input {
  flex: 1;
  height: 40px;
  padding: 0 16px;
  background-color: #F2F2F7;
  border-radius: 20px;
  font-size: 15px;
}

.send-btn {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-color: #E5E5EA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn-active {
  background-color: #007AFF;
}

.send-icon {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
}
