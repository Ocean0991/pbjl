.feedback-shell {
  padding-top: 44rpx;
}

.feedback-panel {
  border-radius: 40rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.theme-dark .feedback-panel {
  background: linear-gradient(180deg, rgba(25, 29, 38, 0.98), rgba(11, 14, 20, 0.98));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.42);
}

.theme-light .feedback-panel {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(242, 246, 251, 0.98));
  border: 1rpx solid rgba(17, 31, 49, 0.08);
  box-shadow: 0 24rpx 64rpx rgba(17, 31, 49, 0.12);
}

.panel-handle {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  margin: 0 auto 28rpx;
}

.theme-dark .panel-handle {
  background: rgba(255, 255, 255, 0.18);
}

.theme-light .panel-handle {
  background: rgba(17, 31, 49, 0.16);
}

.feedback-block {
  border-radius: 32rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.compact-block {
  padding-bottom: 22rpx;
}

.theme-dark .feedback-block {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.theme-light .feedback-block {
  background: rgba(17, 31, 49, 0.03);
  border: 1rpx solid rgba(17, 31, 49, 0.08);
}

.field-heading {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  display: block;
}

.feedback-textarea,
.feedback-input {
  width: 100%;
  border: none;
  background: transparent;
  color: inherit;
  font-size: 32rpx;
  line-height: 1.65;
  margin-top: 18rpx;
  box-sizing: border-box;
  padding: 8rpx 0;
}

.feedback-textarea {
  min-height: 280rpx;
}

.feedback-input {
  padding: 12rpx 0;
  min-height: 56rpx;
}

.feedback-placeholder {
  color: rgba(245, 247, 251, 0.45);
  font-size: 30rpx;
}

.theme-light .feedback-placeholder {
  color: rgba(19, 32, 46, 0.42);
}

.field-count {
  display: block;
  margin-top: 18rpx;
  text-align: right;
  font-size: 22rpx;
  line-height: 1.4;
  opacity: 0.56;
}

.screenshot-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 18rpx -8rpx 0;
}

.add-tile,
.screenshot-tile {
  width: calc(33.333% - 16rpx);
  height: 180rpx;
  border-radius: 24rpx;
  margin: 8rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.theme-dark .add-tile,
.theme-dark .screenshot-tile {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.theme-light .add-tile,
.theme-light .screenshot-tile {
  background: rgba(17, 31, 49, 0.04);
  border: 1rpx solid rgba(17, 31, 49, 0.08);
}

.add-tile {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.add-plus {
  font-size: 78rpx;
  line-height: 0.9;
  color: #96e55d;
}

.add-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  opacity: 0.8;
}

.screenshot-image {
  width: 100%;
  height: 100%;
}

.remove-badge {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  font-size: 20rpx;
  line-height: 1.2;
  background: rgba(8, 11, 16, 0.7);
  color: #f5f7fb;
}

.feedback-meta {
  margin-top: 24rpx;
}

.feedback-meta .caption + .caption {
  margin-top: 8rpx;
}

.action-row {
  display: flex;
  margin: 28rpx -10rpx 0;
}

.action-button {
  width: calc(50% - 20rpx);
  margin: 0 10rpx;
}

.submit-button {
  color: #06110b;
}
