.time-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-label {
  font-size: 26rpx;
  font-weight: 500;
}

.theme-dark .time-label {
  color: rgba(255, 255, 255, 0.45);
}

.theme-light .time-label {
  color: rgba(19, 32, 46, 0.45);
}

.time-input {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-variant-numeric: tabular-nums;
}
.theme-dark .time-input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.theme-light .time-input {
  background: rgba(17, 31, 49, 0.04);
  border: 1rpx solid rgba(17, 31, 49, 0.06);
}
