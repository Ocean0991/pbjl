.option-chip {
  min-width: calc(50% - 16rpx);
  text-align: center;
  justify-content: center;
  display: flex;
  align-items: center;
}

.home-hero {
  padding-bottom: 40rpx;
}

.landing-shell {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.landing-hero {
  padding-top: 60rpx;
}

.landing-hero-compact {
  margin-top: 80rpx;
  min-height: 0;
}

.landing-badge-row {
  margin-bottom: 12rpx;
}

.main-task-card {
  padding-top: 20rpx;
}

.alert-card {
  border-left: 6rpx solid rgba(255, 159, 67, 0.6);
}

.theme-dark .alert-card {
  background: rgba(255, 159, 67, 0.08);
}

.theme-light .alert-card {
  background: rgba(230, 126, 34, 0.06);
}

.feedback-note {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
}

.theme-dark .feedback-note {
  background: rgba(46, 204, 113, 0.08);
  border: 1rpx solid rgba(46, 204, 113, 0.12);
}

.theme-light .feedback-note {
  background: rgba(46, 204, 113, 0.06);
  border: 1rpx solid rgba(46, 204, 113, 0.1);
}

.weekly-card {
  margin-bottom: 0;
}

.guide-card {
  border-left: 6rpx solid rgba(71, 160, 255, 0.6);
}

.theme-dark .guide-card {
  background: rgba(71, 160, 255, 0.08);
}

.theme-light .guide-card {
  background: rgba(71, 160, 255, 0.06);
}

.share-prompt-card {
  border-left: 6rpx solid rgba(46, 204, 113, 0.6);
}

.theme-dark .share-prompt-card {
  background: rgba(46, 204, 113, 0.08);
}

.theme-light .share-prompt-card {
  background: rgba(46, 204, 113, 0.06);
}

.hero-number {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -6rpx;
}

.theme-dark .hero-number {
  background: linear-gradient(135deg, #ffffff 0%, rgba(255, 255, 255, 0.85) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 80rpx rgba(46, 204, 113, 0.2);
}

.theme-light .hero-number {
  color: #0a0d12;
}

.hero-number-unit {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 8rpx;
  vertical-align: top;
}

.theme-dark .hero-number-unit {
  color: rgba(255, 255, 255, 0.6);
}

.theme-light .hero-number-unit {
  color: rgba(19, 32, 46, 0.65);
}

.hero-number-label {
  font-size: 26rpx;
  margin-top: 12rpx;
  display: block;
}

.theme-dark .hero-number-label {
  color: rgba(255, 255, 255, 0.45);
}

.theme-light .hero-number-label {
  color: rgba(19, 32, 46, 0.5);
}

.hero-metrics-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.theme-light .hero-metrics-grid {
  border-top-color: rgba(17, 31, 49, 0.06);
}

.hero-metric-item {
  text-align: center;
  flex: 1;
}

.hero-metric-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  display: block;
}

.theme-dark .hero-metric-value {
  color: #ffffff;
}

.theme-light .hero-metric-value {
  color: #0a0d12;
}

.hero-metric-label {
  font-size: 22rpx;
  margin-top: 8rpx;
  display: block;
}

.theme-dark .hero-metric-label {
  color: rgba(255, 255, 255, 0.4);
}

.theme-light .hero-metric-label {
  color: rgba(19, 32, 46, 0.45);
}

.task-target {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -2rpx;
  margin-top: 20rpx;
  display: block;
}

.theme-dark .task-target {
  background: linear-gradient(135deg, #ffffff 0%, rgba(255, 255, 255, 0.85) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.theme-light .task-target {
  color: #0a0d12;
}

.task-purpose {
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  display: block;
}

.theme-dark .task-purpose {
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.7);
}

.theme-light .task-purpose {
  background: rgba(17, 31, 49, 0.04);
  color: rgba(19, 32, 46, 0.75);
}

.task-avoid {
  font-size: 26rpx;
  line-height: 1.55;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  display: block;
}

.theme-dark .task-avoid {
  background: rgba(255, 107, 107, 0.08);
  color: rgba(255, 107, 107, 0.85);
  border: 1rpx solid rgba(255, 107, 107, 0.12);
}

.theme-light .task-avoid {
  background: rgba(231, 76, 60, 0.06);
  color: rgba(231, 76, 60, 0.85);
  border: 1rpx solid rgba(231, 76, 60, 0.1);
}

.quick-status-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx -8rpx 0;
}

.quick-status-item {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.theme-dark .quick-status-item {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.theme-dark .quick-status-item:active {
  background: rgba(46, 204, 113, 0.15);
  border-color: rgba(46, 204, 113, 0.3);
  color: #2ecc71;
}

.theme-light .quick-status-item {
  background: rgba(17, 31, 49, 0.04);
  color: rgba(19, 32, 46, 0.85);
  border: 1rpx solid rgba(17, 31, 49, 0.06);
}

.theme-light .quick-status-item:active {
  background: rgba(46, 204, 113, 0.1);
  border-color: rgba(46, 204, 113, 0.25);
  color: #1a9f53;
}

.weekly-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.weekly-progress-percent {
  font-size: 32rpx;
  font-weight: 700;
}

.theme-dark .weekly-progress-percent {
  color: #2ecc71;
}

.theme-light .weekly-progress-percent {
  color: #1a9f53;
}

.weekly-signal-list {
  margin-top: 24rpx;
}

.weekly-signal-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.weekly-signal-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.weekly-signal-text {
  font-size: 28rpx;
  line-height: 1.55;
}

.theme-dark .weekly-signal-text {
  color: rgba(255, 255, 255, 0.7);
}

.theme-light .weekly-signal-text {
  color: rgba(19, 32, 46, 0.75);
}

.weekly-suggestion-box {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
}

.theme-dark .weekly-suggestion-box {
  background: rgba(46, 204, 113, 0.08);
  border: 1rpx solid rgba(46, 204, 113, 0.12);
}

.theme-light .weekly-suggestion-box {
  background: rgba(46, 204, 113, 0.06);
  border: 1rpx solid rgba(46, 204, 113, 0.1);
}

.weekly-suggestion-label {
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  display: block;
}

.theme-dark .weekly-suggestion-label {
  color: rgba(255, 255, 255, 0.4);
}

.theme-light .weekly-suggestion-label {
  color: rgba(19, 32, 46, 0.45);
}

.weekly-suggestion-text {
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 500;
}

.theme-dark .weekly-suggestion-text {
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .weekly-suggestion-text {
  color: rgba(19, 32, 46, 0.85);
}

.hero-main {
  text-align: center;
  padding-bottom: 20rpx;
}

.hero-number-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 16rpx;
}

.adjustment-card {
  border-left: 6rpx solid rgba(71, 160, 255, 0.6);
}

.theme-dark .adjustment-card {
  background: rgba(71, 160, 255, 0.08);
}

.theme-light .adjustment-card {
  background: rgba(71, 160, 255, 0.06);
}

.adjustment-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.info-trigger {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.theme-dark .info-trigger {
  background: rgba(255, 255, 255, 0.08);
}

.theme-light .info-trigger {
  background: rgba(17, 31, 49, 0.06);
}

.info-icon {
  font-size: 24rpx;
  font-weight: 600;
}

.theme-dark .info-icon {
  color: rgba(255, 255, 255, 0.6);
}

.theme-light .info-icon {
  color: rgba(19, 32, 46, 0.65);
}

.task-actions {
  margin-top: 28rpx;
}

.task-detail-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.theme-dark .task-detail-trigger {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.theme-light .task-detail-trigger {
  background: rgba(17, 31, 49, 0.04);
  border: 1rpx solid rgba(17, 31, 49, 0.06);
}

.detail-text {
  font-size: 26rpx;
  font-weight: 500;
}

.theme-dark .detail-text {
  color: rgba(255, 255, 255, 0.6);
}

.theme-light .detail-text {
  color: rgba(19, 32, 46, 0.65);
}

.detail-arrow {
  font-size: 32rpx;
  font-weight: 300;
}

.theme-dark .detail-arrow {
  color: rgba(255, 255, 255, 0.4);
}

.theme-light .detail-arrow {
  color: rgba(19, 32, 46, 0.45);
}

.quick-status-card {
  padding-top: 20rpx;
}

.status-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 8rpx;
}

.status-label {
  font-size: 26rpx;
  font-weight: 500;
  display: block;
}

.theme-dark .status-label {
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .status-label {
  color: rgba(19, 32, 46, 0.85);
}

.sheet-section {
  margin-bottom: 32rpx;
}

.sheet-section:last-child {
  margin-bottom: 0;
}

.sheet-section-title {
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.theme-dark .sheet-section-title {
  color: rgba(255, 255, 255, 0.45);
}

.theme-light .sheet-section-title {
  color: rgba(19, 32, 46, 0.5);
}

.sheet-section-text {
  font-size: 28rpx;
  line-height: 1.6;
  display: block;
}

.theme-dark .sheet-section-text {
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .sheet-section-text {
  color: rgba(19, 32, 46, 0.85);
}

.sheet-section-text + .sheet-section-text {
  margin-top: 12rpx;
}

.pace-highlight {
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.theme-dark .pace-highlight {
  color: #2ecc71;
}

.theme-light .pace-highlight {
  color: #1a9f53;
}

.sheet-section-hint {
  font-size: 22rpx;
  margin-top: 8rpx;
  display: block;
}

.theme-dark .sheet-section-hint {
  color: rgba(255, 255, 255, 0.4);
}

.theme-light .sheet-section-hint {
  color: rgba(19, 32, 46, 0.45);
}

.motivation-card {
  border-left: 6rpx solid rgba(46, 204, 113, 0.6);
  padding: 32rpx 40rpx;
}

.theme-dark .motivation-card {
  background: rgba(46, 204, 113, 0.06);
}

.theme-light .motivation-card {
  background: rgba(46, 204, 113, 0.04);
}

.motivation-text {
  font-size: 30rpx;
  line-height: 1.65;
  font-weight: 500;
  display: block;
}

.theme-dark .motivation-text {
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .motivation-text {
  color: rgba(19, 32, 46, 0.85);
}

.task-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.key-workout-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.theme-dark .key-workout-badge {
  background: rgba(46, 204, 113, 0.15);
  color: #2ecc71;
}

.theme-light .key-workout-badge {
  background: rgba(46, 204, 113, 0.12);
  color: #1a9f53;
}

.task-pace-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
}

.theme-dark .task-pace-row {
  background: rgba(46, 204, 113, 0.08);
}

.theme-light .task-pace-row {
  background: rgba(46, 204, 113, 0.06);
}

.task-pace-label {
  font-size: 26rpx;
  font-weight: 500;
}

.theme-dark .task-pace-label {
  color: rgba(255, 255, 255, 0.6);
}

.theme-light .task-pace-label {
  color: rgba(19, 32, 46, 0.65);
}

.task-pace-value {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.theme-dark .task-pace-value {
  color: #2ecc71;
}

.theme-light .task-pace-value {
  color: #1a9f53;
}

.task-reminder {
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border-left: 6rpx solid rgba(255, 159, 67, 0.6);
}

.theme-dark .task-reminder {
  background: rgba(255, 159, 67, 0.06);
  color: rgba(255, 255, 255, 0.8);
}

.theme-light .task-reminder {
  background: rgba(255, 159, 67, 0.04);
  color: rgba(19, 32, 46, 0.85);
}

.explanation-card {
  border-left: 6rpx solid rgba(71, 160, 255, 0.6);
}

.theme-dark .explanation-card {
  background: rgba(71, 160, 255, 0.06);
}

.theme-light .explanation-card {
  background: rgba(71, 160, 255, 0.04);
}

.explanation-note {
  margin-top: 16rpx;
}

.avoid-card {
  border-left: 6rpx solid rgba(255, 107, 107, 0.6);
}

.theme-dark .avoid-card {
  background: rgba(255, 107, 107, 0.06);
}

.theme-light .avoid-card {
  background: rgba(255, 107, 107, 0.04);
}

.hero-phase-label {
  font-size: 24rpx;
  font-weight: 500;
  margin-top: 8rpx;
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.theme-dark .hero-phase-label {
  background: rgba(46, 204, 113, 0.12);
  color: #2ecc71;
}

.theme-light .hero-phase-label {
  background: rgba(46, 204, 113, 0.1);
  color: #1a9f53;
}

.prediction-change-card {
  border-left: 6rpx solid rgba(167, 139, 250, 0.6);
}

.theme-dark .prediction-change-card {
  background: rgba(167, 139, 250, 0.06);
}

.theme-light .prediction-change-card {
  background: rgba(167, 139, 250, 0.04);
}
