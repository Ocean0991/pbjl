.profile-hero {
  padding-bottom: 40rpx;
}

.nav-list {
  margin-top: 12rpx;
}

.nav-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.15s ease;
}

.nav-list-item:active {
  opacity: 0.7;
}

.nav-list-item + .nav-list-item {
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

.theme-light .nav-list-item + .nav-list-item {
  border-top-color: rgba(17, 31, 49, 0.04);
}

.nav-list-text {
  font-size: 28rpx;
  font-weight: 500;
}

.theme-dark .nav-list-text {
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .nav-list-text {
  color: rgba(19, 32, 46, 0.85);
}

.nav-list-arrow {
  font-size: 32rpx;
  font-weight: 300;
}

.theme-dark .nav-list-arrow {
  color: rgba(255, 255, 255, 0.3);
}

.theme-light .nav-list-arrow {
  color: rgba(19, 32, 46, 0.35);
}

.compact-metric-row {
  margin-top: 28rpx;
}

.plan-summary-row {
  display: flex;
  margin: 24rpx -10rpx 0;
}

.summary-item {
  flex: 1;
  margin: 0 10rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  text-align: center;
}

.theme-dark .summary-item {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.theme-light .summary-item {
  background: rgba(17, 31, 49, 0.04);
  border: 1rpx solid rgba(17, 31, 49, 0.05);
}

.summary-label {
  font-size: 22rpx;
  line-height: 1.4;
  display: block;
}

.theme-dark .summary-label {
  color: rgba(255, 255, 255, 0.45);
}

.theme-light .summary-label {
  color: rgba(19, 32, 46, 0.5);
}

.summary-value {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
  display: block;
}

.theme-dark .summary-value {
  color: #ffffff;
}

.theme-light .summary-value {
  color: #0a0d12;
}

.card:last-of-type {
  margin-bottom: 0;
}

.profile-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.profile-section-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.theme-dark .profile-section-badge {
  background: rgba(46, 204, 113, 0.15);
  color: #2ecc71;
}

.theme-light .profile-section-badge {
  background: rgba(46, 204, 113, 0.12);
  color: #1a9f53;
}

.profile-info-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx;
}

.profile-info-item {
  width: calc(50% - 16rpx);
  margin: 12rpx 8rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
}

.theme-dark .profile-info-item {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.theme-light .profile-info-item {
  background: rgba(17, 31, 49, 0.04);
  border: 1rpx solid rgba(17, 31, 49, 0.05);
}

.profile-info-label {
  font-size: 22rpx;
  line-height: 1.4;
  display: block;
  margin-bottom: 8rpx;
}

.theme-dark .profile-info-label {
  color: rgba(255, 255, 255, 0.4);
}

.theme-light .profile-info-label {
  color: rgba(19, 32, 46, 0.45);
}

.profile-info-value {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  display: block;
}

.theme-dark .profile-info-value {
  color: rgba(255, 255, 255, 0.85);
}

.theme-light .profile-info-value {
  color: rgba(19, 32, 46, 0.85);
}

.action-card {
  position: relative;
  overflow: hidden;
}

.action-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  border-radius: 4rpx;
}

.theme-dark .action-card::before {
  background: linear-gradient(90deg, rgba(46, 204, 113, 0.6), rgba(71, 160, 255, 0.6));
}

.theme-light .action-card::before {
  background: linear-gradient(90deg, rgba(26, 159, 83, 0.6), rgba(41, 128, 185, 0.6));
}

.share-card {
  border-left: 6rpx solid rgba(46, 204, 113, 0.5);
}

.theme-dark .share-card {
  background: rgba(46, 204, 113, 0.06);
}

.theme-light .share-card {
  background: rgba(46, 204, 113, 0.04);
}

.feedback-card {
  border-left: 6rpx solid rgba(71, 160, 255, 0.5);
}

.theme-dark .feedback-card {
  background: rgba(71, 160, 255, 0.06);
}

.theme-light .feedback-card {
  background: rgba(71, 160, 255, 0.04);
}

.danger-zone {
  border-left: 6rpx solid rgba(255, 107, 107, 0.5);
}

.theme-dark .danger-zone {
  background: rgba(255, 107, 107, 0.06);
}

.theme-light .danger-zone {
  background: rgba(231, 76, 60, 0.04);
}

.danger-button {
  background: rgba(255, 107, 107, 0.15) !important;
  color: #ff6b6b !important;
  border: none !important;
}

.theme-light .danger-button {
  background: rgba(231, 76, 60, 0.12) !important;
  color: #e74c3c !important;
}

.version-info {
  text-align: center;
  padding: 32rpx 0;
}

.version-text {
  font-size: 24rpx;
  display: block;
}

.theme-dark .version-text {
  color: rgba(255, 255, 255, 0.3);
}

.theme-light .version-text {
  color: rgba(19, 32, 46, 0.35);
}
