.version-list {
  margin-top: 16rpx;
}

.version-item {
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.theme-dark .version-item {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.theme-light .version-item {
  background: rgba(17, 31, 49, 0.04);
  border: 1rpx solid rgba(17, 31, 49, 0.06);
}

.version-item:active {
  opacity: 0.7;
}

.version-active {
  border-color: rgba(46, 204, 113, 0.3) !important;
}

.theme-dark .version-active {
  background: rgba(46, 204, 113, 0.06);
}

.theme-light .version-active {
  background: rgba(46, 204, 113, 0.04);
}

.version-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.version-label {
  font-size: 28rpx;
  font-weight: 600;
}

.theme-dark .version-label {
  color: rgba(255, 255, 255, 0.9);
}

.theme-light .version-label {
  color: rgba(19, 32, 46, 0.9);
}

.version-goal {
  font-size: 26rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.theme-dark .version-goal {
  color: rgba(255, 255, 255, 0.7);
}

.theme-light .version-goal {
  color: rgba(19, 32, 46, 0.75);
}

.version-date {
  font-size: 22rpx;
  display: block;
  margin-bottom: 8rpx;
}

.theme-dark .version-date {
  color: rgba(255, 255, 255, 0.4);
}

.theme-light .version-date {
  color: rgba(19, 32, 46, 0.45);
}

.version-summary {
  font-size: 24rpx;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
}

.theme-dark .version-summary {
  color: rgba(255, 255, 255, 0.6);
}

.theme-light .version-summary {
  color: rgba(19, 32, 46, 0.65);
}

.version-meta {
  display: flex;
  gap: 16rpx;
}

.version-meta-item {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.theme-dark .version-meta-item {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.5);
}

.theme-light .version-meta-item {
  background: rgba(17, 31, 49, 0.06);
  color: rgba(19, 32, 46, 0.55);
}
