.container {
  padding: 16px;
  padding-bottom: 100px;
  background-color: #F2F2F7;
}

.plan-trust-banner {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 16px;
}

.trust-title {
  font-size: 15px;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 4px;
}

.trust-desc {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.month-header {
  margin-bottom: 16px;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
}

.nav-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  background-color: #FFFFFF;
}

.nav-icon {
  width: 20px;
  height: 20px;
}

.nav-arrow {
  font-size: 24px;
  font-weight: 500;
  color: #1C1C1E;
}

.month-title {
  font-size: 20px;
  font-weight: 600;
  color: #1C1C1E;
}

.week-days {
  display: flex;
  justify-content: space-around;
  margin-bottom: 8px;
  padding: 0 8px;
}

.day-label {
  font-size: 12px;
  font-weight: 500;
  color: #636366;
  text-align: center;
  width: 48px;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 8px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.day-cell {
  width: 48px;
  height: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 24px;
}

.day-today {
  background-color: #007AFF;
}

.day-today .day-number {
  color: #FFFFFF;
}

.day-other-month .day-number {
  color: #C7C7CC;
}

.day-number {
  font-size: 16px;
  font-weight: 500;
  color: #1C1C1E;
}

.workout-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  position: absolute;
  bottom: 6px;
}

.dot-easy {
  background-color: #34C759;
}

.dot-long {
  background-color: #007AFF;
}

.dot-quality {
  background-color: #FF9500;
}

.dot-recovery {
  background-color: #8E8E93;
}

.dot-strength {
  background-color: #AF52DE;
}

.completed-check {
  position: absolute;
  top: 4px;
  right: 4px;
}

.check-icon {
  width: 16px;
  height: 16px;
}

.week-detail {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.week-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.week-title {
  font-size: 20px;
  font-weight: 600;
  color: #1C1C1E;
}

.week-phase {
  font-size: 14px;
  color: #636366;
  background-color: #F2F2F7;
  padding: 4px 12px;
  border-radius: 12px;
}

.workout-list {
  display: flex;
  flex-direction: column;
}

.workout-item {
  display: flex;
  align-items: center;
  padding: 16px 0;
  border-bottom: 0.5px solid #E5E5EA;
}

.workout-item:last-child {
  border-bottom: none;
}

.workout-today {
  background-color: rgba(0, 122, 255, 0.05);
  margin: 0 -20px;
  padding: 16px 20px;
  border-radius: 12px;
  border-bottom: none;
}

.workout-date {
  width: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12px;
}

.date-weekday {
  font-size: 12px;
  color: #636366;
  margin-bottom: 2px;
}

.date-day {
  font-size: 18px;
  font-weight: 600;
  color: #1C1C1E;
}

.workout-info {
  flex: 1;
}

.workout-type-tag {
  display: inline-flex;
  align-items: center;
  height: 24px;
  padding: 0 8px;
  border-radius: 12px;
  margin-bottom: 4px;
}

.tag-easy {
  background-color: rgba(52, 199, 89, 0.1);
}

.tag-long {
  background-color: rgba(0, 122, 255, 0.1);
}

.tag-quality {
  background-color: rgba(255, 149, 0, 0.1);
}

.tag-recovery {
  background-color: rgba(142, 142, 147, 0.1);
}

.tag-strength {
  background-color: rgba(175, 82, 222, 0.1);
}

.tag-rest {
  background-color: #E5E5EA;
}

.tag-text {
  font-size: 12px;
  font-weight: 500;
}

.tag-easy .tag-text {
  color: #34C759;
}

.tag-long .tag-text {
  color: #007AFF;
}

.tag-quality .tag-text {
  color: #FF9500;
}

.tag-recovery .tag-text {
  color: #8E8E93;
}

.tag-strength .tag-text {
  color: #AF52DE;
}

.tag-rest .tag-text {
  color: #636366;
}

.workout-title {
  font-size: 16px;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 2px;
}

.workout-target {
  font-size: 14px;
  color: #636366;
  display: block;
}

.workout-status {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon {
  width: 24px;
  height: 24px;
}

.status-completed {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #34C759;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-missed {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-pending {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  border: 2px solid #C7C7CC;
  color: #C7C7CC;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-overview {
  display: flex;
  justify-content: space-around;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.overview-item {
  text-align: center;
}

.overview-label {
  font-size: 12px;
  color: #636366;
  display: block;
  margin-bottom: 4px;
}

.overview-value {
  font-size: 18px;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
}

.overview-divider {
  width: 1px;
  background-color: #E5E5EA;
}

.blackout-hint {
  font-size: 12px;
  color: #8E8E93;
  display: block;
  text-align: center;
  margin-top: 4px;
}

.day-blackout {
  background-color: rgba(255, 59, 48, 0.1);
}

.day-blackout .day-number {
  color: #FF3B30;
}

.blackout-mark {
  font-size: 10px;
  color: #FF3B30;
  position: absolute;
  bottom: 4px;
}

.blackout-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.blackout-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 24px;
  padding-bottom: 40px;
}

.blackout-title {
  font-size: 20px;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 8px;
}

.blackout-desc {
  font-size: 14px;
  color: #636366;
  display: block;
  margin-bottom: 20px;
}

.blackout-actions {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.blackout-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
  background-color: #F2F2F7;
  border-radius: 12px;
}

.action-icon {
  font-size: 24px;
  margin-bottom: 8px;
}

.action-label {
  font-size: 13px;
  color: #1C1C1E;
  font-weight: 500;
}
