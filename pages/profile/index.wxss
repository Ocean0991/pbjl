.container {
  padding: 0;
  padding-bottom: 100px;
  background-color: #F2F2F7;
  min-height: 100vh;
}

.profile-header {
  text-align: center;
  padding: 40px 20px 32px;
  background-color: #FFFFFF;
}

.avatar {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  margin: 0 auto 12px;
  background-color: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 36px;
}

.nickname {
  font-size: 24px;
  font-weight: 700;
  color: #000000;
  display: block;
  margin-bottom: 6px;
}

.goal-race {
  font-size: 15px;
  color: #636366;
  display: block;
}

.training-profile {
  margin: 16px;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 18px;
  font-weight: 700;
  color: #000000;
  display: block;
  margin-bottom: 16px;
}

.profile-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 0.5px solid #F2F2F7;
}

.profile-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 15px;
  color: #636366;
}

.item-value {
  font-size: 15px;
  font-weight: 600;
  color: #1C1C1E;
}

.settings-section {
  margin: 0 16px 16px;
  background-color: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 0.5px solid #F2F2F7;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item-premium {
  background-color: rgba(255, 149, 0, 0.04);
}

.item-left {
  display: flex;
  align-items: center;
}

.item-emoji {
  font-size: 20px;
  margin-right: 12px;
}

.item-text {
  font-size: 16px;
  color: #1C1C1E;
}

.premium-text {
  color: #FF9500 !important;
  font-weight: 600;
}

.item-arrow {
  font-size: 20px;
  color: #C7C7CC;
  font-weight: 500;
}

.stats-summary {
  margin: 0 16px;
  display: flex;
  justify-content: space-around;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 24px 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.summary-item {
  text-align: center;
  flex: 1;
}

.summary-value {
  font-size: 28px;
  font-weight: 700;
  color: #000000;
  display: block;
  margin-bottom: 4px;
}

.summary-label {
  font-size: 12px;
  color: #8E8E93;
  display: block;
}

.summary-divider {
  width: 1px;
  background-color: #E5E5EA;
}

.pr-section {
  margin: 0 16px 16px;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-hint {
  font-size: 12px;
  color: #8E8E93;
}

.pr-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.pr-item {
  background-color: #F2F2F7;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
}

.pr-distance {
  font-size: 14px;
  font-weight: 600;
  color: #636366;
  display: block;
  margin-bottom: 8px;
}

.pr-time {
  font-size: 24px;
  font-weight: 700;
  color: #000000;
  display: block;
  margin-bottom: 4px;
}

.pr-date {
  font-size: 11px;
  color: #8E8E93;
  display: block;
}

.card {
  background-color: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}
