<view class="container">
  <view class="stats-overview">
    <view class="stat-card">
      <text class="stat-value">{{weekDistance}}</text>
      <text class="stat-unit">km</text>
      <text class="stat-label">本周跑量</text>
    </view>

    <view class="stat-card">
      <text class="stat-value">{{monthDistance}}</text>
      <text class="stat-unit">km</text>
      <text class="stat-label">本月跑量</text>
    </view>

    <view class="stat-card">
      <text class="stat-value">{{totalDistance}}</text>
      <text class="stat-unit">km</text>
      <text class="stat-label">总跑量</text>
    </view>
  </view>

  <view class="load-section">
    <view class="section-header">
      <text class="section-title">训练负荷</text>
      <text class="section-link" bindtap="onViewLoadDetail">详情</text>
    </view>

    <view class="load-cards">
      <view class="load-card">
        <text class="load-label">疲劳度 ATL</text>
        <text class="load-value">{{atl}}</text>
      </view>

      <view class="load-card">
        <text class="load-label">体能 CTL</text>
        <text class="load-value">{{ctl}}</text>
      </view>

      <view class="load-card {{tsbClass}}">
        <text class="load-label">状态 TSB</text>
        <text class="load-value">{{tsb}}</text>
      </view>
    </view>
  </view>

  <view class="records-section">
    <view class="section-header">
      <text class="section-title">训练记录</text>
    </view>

    <view wx:if="{{records.length > 0}}" class="records-list">
      <view wx:for="{{records}}" wx:key="dateKey" class="record-item" bindtap="onViewRecord" data-date="{{item.dateKey}}">
        <view class="record-icon {{'icon-' + item.type}}">
          <text class="type-emoji">{{item.type === 'easy' ? '👟' : item.type === 'long' ? '🏃' : item.type === 'quality' ? '⚡' : item.type === 'recovery' ? '💆' : item.type === 'strength' ? '🏋️' : '👟'}}</text>
        </view>

        <view class="record-info">
          <view class="record-header">
            <text class="record-title">{{item.title}}</text>
            <text class="record-date">{{item.dateLabel}}</text>
          </view>

          <view class="record-stats">
            <view class="stat-item">
              <text class="stat-number">{{item.distance}}</text>
              <text class="stat-text">km</text>
            </view>

            <view class="stat-divider"></view>

            <view class="stat-item">
              <text class="stat-number">{{item.duration}}</text>
              <text class="stat-text">分钟</text>
            </view>

            <view class="stat-divider"></view>

            <view class="stat-item">
              <text class="stat-number">{{item.pace}}</text>
              <text class="stat-text">配速</text>
            </view>
          </view>
        </view>

        <text class="record-arrow">›</text>
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-emoji">🏃</text>
      <text class="empty-title">还没有训练记录</text>
      <text class="empty-description">完成训练后会在这里显示</text>
    </view>
  </view>
</view>
