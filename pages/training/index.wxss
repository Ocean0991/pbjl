.container {
  padding: 16px;
  padding-bottom: 100px;
  background-color: #F2F2F7;
}

.stats-overview {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16px;
}

.stat-card {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px 12px;
  margin: 0 4px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.stat-card:first-child {
  margin-left: 0;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-value {
  font-size: 32px;
  font-weight: 700;
  color: #000000;
  display: block;
}

.stat-unit {
  font-size: 14px;
  color: #636366;
  display: block;
  margin-top: -4px;
}

.stat-label {
  font-size: 12px;
  color: #636366;
  display: block;
  margin-top: 8px;
}

.load-section {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-title {
  font-size: 20px;
  font-weight: 600;
  color: #1C1C1E;
}

.section-link {
  font-size: 14px;
  color: #007AFF;
}

.load-cards {
  display: flex;
  justify-content: space-between;
}

.load-card {
  flex: 1;
  text-align: center;
  padding: 12px;
  background-color: #F2F2F7;
  border-radius: 12px;
  margin: 0 4px;
}

.load-card:first-child {
  margin-left: 0;
}

.load-card:last-child {
  margin-right: 0;
}

.load-label {
  font-size: 12px;
  color: #636366;
  display: block;
  margin-bottom: 8px;
}

.load-value {
  font-size: 24px;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
}

.load-card.positive {
  background-color: rgba(52, 199, 89, 0.1);
}

.load-card.positive .load-value {
  color: #34C759;
}

.load-card.negative {
  background-color: rgba(255, 59, 48, 0.1);
}

.load-card.negative .load-value {
  color: #FF3B30;
}

.records-section {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.records-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 16px 0;
  border-bottom: 0.5px solid #E5E5EA;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.icon-easy {
  background-color: rgba(52, 199, 89, 0.1);
}

.icon-long {
  background-color: rgba(0, 122, 255, 0.1);
}

.icon-quality {
  background-color: rgba(255, 149, 0, 0.1);
}

.icon-recovery {
  background-color: rgba(142, 142, 147, 0.1);
}

.icon-strength {
  background-color: rgba(175, 82, 222, 0.1);
}

.type-icon {
  width: 24px;
  height: 24px;
}

.type-emoji {
  font-size: 24px;
}

.record-info {
  flex: 1;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.record-title {
  font-size: 16px;
  font-weight: 600;
  color: #1C1C1E;
}

.record-date {
  font-size: 12px;
  color: #636366;
}

.record-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  display: flex;
  align-items: baseline;
}

.stat-number {
  font-size: 16px;
  font-weight: 600;
  color: #000000;
}

.stat-text {
  font-size: 12px;
  color: #636366;
  margin-left: 2px;
}

.stat-divider {
  width: 1px;
  height: 16px;
  background-color: #E5E5EA;
  margin: 0 12px;
}

.record-arrow {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  width: 20px;
  height: 20px;
  opacity: 0.3;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
}

.empty-emoji {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-title {
  font-size: 18px;
  font-weight: 600;
  color: #3A3A3C;
  margin-bottom: 8px;
}

.empty-description {
  font-size: 14px;
  color: #636366;
  text-align: center;
}
