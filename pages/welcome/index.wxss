.welcome-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 80rpx 48rpx 48rpx;
  box-sizing: border-box;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.logo-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.intro-section {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.intro-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #7effb4;
  margin-bottom: 16rpx;
}

.intro-desc {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.85);
}

.features-section {
  flex: 1;
  margin-bottom: 48rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
  line-height: 1;
}

.feature-content {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.action-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 24rpx;
}

.time-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 20rpx;
}
