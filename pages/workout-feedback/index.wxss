.container {
  padding: 16px;
  padding-bottom: 100px;
  background-color: #F2F2F7;
}

.completion-header {
  text-align: center;
  padding: 32px 0;
}

.checkmark-circle {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  background-color: #34C759;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
}

.checkmark-icon {
  font-size: 32px;
  color: #FFFFFF;
  font-weight: 700;
}

.completion-title {
  font-size: 28px;
  font-weight: 700;
  color: #000000;
  display: block;
  margin-bottom: 8px;
}

.completion-subtitle {
  font-size: 16px;
  color: #636366;
  display: block;
}

.stats-summary {
  display: flex;
  justify-content: space-around;
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.summary-item {
  text-align: center;
  flex: 1;
}

.summary-value {
  font-size: 32px;
  font-weight: 700;
  color: #000000;
  display: block;
}

.summary-unit {
  font-size: 14px;
  color: #636366;
  display: block;
  margin-top: -4px;
}

.summary-label {
  font-size: 12px;
  color: #636366;
  display: block;
  margin-top: 8px;
}

.summary-divider {
  width: 1px;
  background-color: #E5E5EA;
}

.feedback-section {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 20px;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 20px;
}

.rpe-rating {
  margin-bottom: 24px;
}

.rpe-label {
  font-size: 16px;
  font-weight: 500;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12px;
}

.rpe-scale {
  display: flex;
  justify-content: space-between;
}

.rpe-item {
  flex: 1;
  text-align: center;
  padding: 12px 8px;
  border-radius: 12px;
  background-color: #F2F2F7;
  margin: 0 4px;
}

.rpe-item:first-child {
  margin-left: 0;
}

.rpe-item:last-child {
  margin-right: 0;
}

.rpe-selected {
  background-color: #007AFF;
}

.rpe-value {
  font-size: 20px;
  font-weight: 700;
  color: #1C1C1E;
  display: block;
  margin-bottom: 4px;
}

.rpe-selected .rpe-value {
  color: #FFFFFF;
}

.rpe-label {
  font-size: 12px;
  color: #636366;
  display: block;
}

.rpe-selected .rpe-label {
  color: rgba(255, 255, 255, 0.8);
}

.feeling-options {
  margin-bottom: 24px;
}

.feeling-label {
  font-size: 16px;
  font-weight: 500;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12px;
}

.feeling-list {
  display: flex;
  justify-content: space-between;
}

.feeling-item {
  flex: 1;
  text-align: center;
  padding: 16px 8px;
  border-radius: 12px;
  background-color: #F2F2F7;
  margin: 0 4px;
}

.feeling-item:first-child {
  margin-left: 0;
}

.feeling-item:last-child {
  margin-right: 0;
}

.feeling-selected {
  background-color: rgba(52, 199, 89, 0.1);
  border: 2px solid #34C759;
}

.feeling-icon {
  width: 32px;
  height: 32px;
  margin-bottom: 8px;
}

.feeling-text {
  font-size: 14px;
  color: #1C1C1E;
  display: block;
}

.feeling-selected .feeling-text {
  color: #34C759;
  font-weight: 500;
}

.completion-options {
  margin-bottom: 24px;
}

.completion-label {
  font-size: 16px;
  font-weight: 500;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12px;
}

.completion-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.completion-item {
  padding: 16px;
  border-radius: 12px;
  background-color: #F2F2F7;
}

.completion-selected {
  background-color: rgba(0, 122, 255, 0.1);
  border: 2px solid #007AFF;
}

.completion-text {
  font-size: 16px;
  color: #1C1C1E;
  display: block;
}

.completion-selected .completion-text {
  color: #007AFF;
  font-weight: 500;
}

.notes-section {
  margin-bottom: 0;
}

.notes-label {
  font-size: 16px;
  font-weight: 500;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12px;
}

.notes-input {
  width: 100%;
  min-height: 100px;
  padding: 12px;
  border-radius: 12px;
  background-color: #F2F2F7;
  font-size: 16px;
  color: #1C1C1E;
  border: none;
}

.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px;
  background-color: #FFFFFF;
  border-top: 0.5px solid #E5E5EA;
}

.coach-comment {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  border-left: 4px solid #007AFF;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.comment-emoji {
  font-size: 20px;
  margin-right: 8px;
}

.comment-title {
  font-size: 16px;
  font-weight: 600;
  color: #1C1C1E;
}

.comment-text {
  font-size: 15px;
  color: #3A3A3C;
  line-height: 24px;
}

.adjustment-card {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  border-left: 4px solid #FF9500;
}

.adjustment-header {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.adjustment-emoji {
  font-size: 20px;
  margin-right: 8px;
}

.adjustment-title {
  font-size: 16px;
  font-weight: 600;
  color: #1C1C1E;
}

.adjustment-text {
  font-size: 15px;
  color: #3A3A3C;
  line-height: 24px;
}

.feeling-emoji {
  font-size: 28px;
  display: block;
  margin-bottom: 4px;
}
