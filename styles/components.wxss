.btn-primary {
  width: 100%;
  height: 56px;
  background-color: var(--color-primary);
  color: var(--color-primary-white);
  border-radius: var(--border-radius-lg);
  font-size: 18px;
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.15s ease;
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-secondary {
  width: 100%;
  height: 48px;
  background-color: var(--color-gray-5);
  color: var(--color-gray-1);
  border-radius: var(--border-radius-lg);
  font-size: 16px;
  font-weight: var(--font-weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.15s ease;
}

.btn-secondary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-text {
  height: 44px;
  background-color: transparent;
  color: var(--color-info);
  font-size: 16px;
  font-weight: var(--font-weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0 16px;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  padding: 0 12px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: var(--font-weight-medium);
}

.tag-easy-run {
  background-color: rgba(52, 199, 89, 0.1);
  color: var(--color-easy-run);
}

.tag-long-run {
  background-color: rgba(0, 122, 255, 0.1);
  color: var(--color-long-run);
}

.tag-quality {
  background-color: rgba(255, 149, 0, 0.1);
  color: var(--color-quality);
}

.tag-recovery {
  background-color: rgba(142, 142, 147, 0.1);
  color: var(--color-recovery);
}

.tag-strength {
  background-color: rgba(175, 82, 222, 0.1);
  color: var(--color-strength);
}

.tag-rest {
  background-color: var(--color-gray-6);
  color: var(--color-gray-3);
}

.progress-circle {
  width: 120px;
  height: 120px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-line {
  height: 8px;
  background-color: var(--color-gray-6);
  border-radius: 4px;
  overflow: hidden;
}

.progress-line-fill {
  height: 100%;
  background-color: var(--color-success);
  border-radius: 4px;
  transition: width 0.3s ease;
}

.divider {
  height: 0.5px;
  background-color: var(--color-gray-4);
  margin: 16px 0;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 16px 0;
  border-bottom: 0.5px solid var(--color-gray-4);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  background-color: var(--color-gray-5);
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 16px;
  font-weight: var(--font-weight-semibold);
  color: var(--color-gray-1);
  margin-bottom: 4px;
}

.list-item-subtitle {
  font-size: 14px;
  color: var(--color-gray-3);
}

.list-item-value {
  font-size: 16px;
  font-weight: var(--font-weight-medium);
  color: var(--color-gray-1);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
  text-align: center;
}

.empty-state-icon {
  width: 80px;
  height: 80px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.empty-state-title {
  font-size: 18px;
  font-weight: var(--font-weight-semibold);
  color: var(--color-gray-2);
  margin-bottom: 8px;
}

.empty-state-description {
  font-size: 14px;
  color: var(--color-gray-3);
  line-height: 20px;
}

.theme-dark {
  background-color: #000000;
  color: #FFFFFF;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #1dcf76, #55d8ff);
  color: #000000;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.primary-button:active {
  opacity: 0.85;
  transform: scale(0.98);
}
